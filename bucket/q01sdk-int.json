  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.4.0/q01sdk-windows-amd64.zip",
      "hash": "58446968b27daae958020553d4001d48f3156b6b877870a43d2df065f32a44ea"
    },
    "arm64": {
