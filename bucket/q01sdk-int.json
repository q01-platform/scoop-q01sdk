  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.0.85/q01sdk-windows-amd64.zip",
      "hash": "0cc63b9c8d76d6676d8a191eb2ead024b083df2ad78e769b37111d7437922afc"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.0.85/q01sdk-windows-arm64.zip",
