  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.10/q01sdk-windows-amd64.zip",
      "hash": "09f81d41c97cdcf01d7ca0e7bbfc79bd69095e7090a7ff7858e89aa0d59aa787"
    },
    "arm64": {
