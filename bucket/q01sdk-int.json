  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.8.1/q01sdk-windows-amd64.zip",
      "hash": "236b88d0b8657adb172443e59312c2a58b22b3635e48a213edd2d1ceeefbb351"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.8.1/q01sdk-windows-arm64.zip",
      "hash": "f27b74c786cd3ae56f52425366146a92a51723448338c3ed7b5884580307dc70"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
