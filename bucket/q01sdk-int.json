  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.8.0/q01sdk-windows-amd64.zip",
      "hash": "ec2d47fdafd45f560e50b0cb3d7a9a80000280ec56bbf98c57ecc04c4b056f8f"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.8.0/q01sdk-windows-arm64.zip",
      "hash": "bbfac3a46220d89571d663166b45f462567fdc1384189825588eb4f010880323"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
