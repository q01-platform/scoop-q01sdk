  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.12/q01sdk-windows-amd64.zip",
      "hash": "85e3f6db7cffdb455ceeb3bd6eea8c325dad01ec189d4ffd8f356c9513eff1f5"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.12/q01sdk-windows-arm64.zip",
