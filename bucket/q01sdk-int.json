  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.2/q01sdk-windows-amd64.zip",
      "hash": "3f7fd477c4468cf8aa563db0be292b54dac32ef6a42141e511a2b27c2b5dc24b"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.2/q01sdk-windows-arm64.zip",
      "hash": "0d72e9fe893fcccf2bfddfbb5613f2f0043494061487e9116a0011924fda7833"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
