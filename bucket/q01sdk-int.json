  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.0.82/q01sdk-windows-amd64.zip",
      "hash": "82e00f05d8f906e038158e7bffaa5e893e81a1acc2ab369ab0fc31d3038aaae4"
    },
    "arm64": {
