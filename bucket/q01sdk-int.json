  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.8/q01sdk-windows-amd64.zip",
      "hash": "dd331a835fae73fc7ef69894af68fc6c7ca6197989f3cfc09b56d563db5cd5c9"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.8/q01sdk-windows-arm64.zip",
      "hash": "a0b528d36499582a81af21a1ae4b230465cfa34adfedf1759e5d7f2494fba603"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
