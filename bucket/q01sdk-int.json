  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.1/q01sdk-windows-amd64.zip",
      "hash": "a78a31f541b527520a311db0bb49baede88e49103e83a6d1c1e32e5273155399"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.1/q01sdk-windows-arm64.zip",
      "hash": "30469b2ac616707cf41c16fccaf6ffce5f2211f0e2686eadea5859b80a427447"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
