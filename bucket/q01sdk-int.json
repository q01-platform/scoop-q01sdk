  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.3.1/q01sdk-windows-amd64.zip",
      "hash": "7a744afe0ed3ca3060ff0017085329f4ae15ec0587b0600875643b04b4e51a9d"
    },
    "arm64": {
