  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.9.0/q01sdk-windows-amd64.zip",
      "hash": "0839e14989b779c929daf29005f3e872f4efb3d53ebc982dee40fe0580c4ba8b"
    },
    "arm64": {
