  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.3.2/q01sdk-windows-amd64.zip",
      "hash": "2c83983f96cb9d855f37a53552ff888cea3051feed879f92963cbbb57664437b"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.3.2/q01sdk-windows-arm64.zip",
      "hash": "6b7b0fd141ca58771e2184c8afcf9b869bbc5bb0235a3e45ce67233010b24398"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
