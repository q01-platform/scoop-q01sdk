{
  "version": "1.3.0",
  "description": "Q01 Platform SDK CLI",
  "homepage": "https://app-int.q01.io",
  "license": "Proprietary",
  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.3.0/q01sdk-windows-amd64.zip",
      "hash": "c80539d9cd08fc78327bf1520c634557bc3effaf480955e540a47b0c87c80bcd"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.3.0/q01sdk-windows-arm64.zip",
      "hash": "90ded908e59268dc9fdafcf77ca58cc1a38a8ecb51799a337f46fd7eaa245dbf"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
