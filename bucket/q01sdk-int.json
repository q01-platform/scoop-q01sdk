  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.5.2/q01sdk-windows-amd64.zip",
      "hash": "e76e73cf14d6e916ea2f5ce1378f3e935c96527fb969781171e18bc1ed181211"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.5.2/q01sdk-windows-arm64.zip",
      "hash": "1ccbea8a56ea4176d86131a652b98dc0aef49bfb3b83b9b66983e14194a95837"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
