  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.16.0/q01sdk-windows-amd64.zip",
      "hash": "5f6ebb6843fba1cbad63ab1e2a7589f0103d6cb85cdf49687454f7dda7705770"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.16.0/q01sdk-windows-arm64.zip",
      "hash": "d5dc799081d2346e51dc02f47a3435521b1905956c6793e204f32a8cc1dbccd2"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
