  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.7/q01sdk-windows-amd64.zip",
      "hash": "4e35f02c2b698a8f099386569ace38e7611968775b9a37f3bfc935ca9a2c6172"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.7/q01sdk-windows-arm64.zip",
      "hash": "edecca3396b0dc491217504c68c80c8cac00252e1195f2217694d63e44876a05"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
