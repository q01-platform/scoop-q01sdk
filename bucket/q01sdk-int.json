  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.0.86/q01sdk-windows-amd64.zip",
      "hash": "b53e5192cf35f68cb6ff947358b010aeb90e653bb60cbf2cc2b7b5c8a1a18f99"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.0.86/q01sdk-windows-arm64.zip",
      "hash": "145c62d474b8e3691be4df6e6b8fc53cf7c4c831ed2029cc08dc1fdca00313c5"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
