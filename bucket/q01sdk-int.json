  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.17.0/q01sdk-windows-amd64.zip",
      "hash": "a1158d0e4759c32839fbc44a30972d9121020a579219d2c53bad9a14fc4e929e"
    },
    "arm64": {
