  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.14.0/q01sdk-windows-amd64.zip",
      "hash": "aa76394d38237fe5d256fa255c4c5b9cbc9159e398b2f129b30469da93a79259"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.14.0/q01sdk-windows-arm64.zip",
      "hash": "093ce101e4b899ec337df215a641cb3d1243fb2e218443107bfc6ebf829a6b45"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
