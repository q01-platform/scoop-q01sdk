  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.5/q01sdk-windows-amd64.zip",
      "hash": "7a2a593f35b87bc57f83f5ab502d7f2f499e99448246c857983018057758dad2"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.5/q01sdk-windows-arm64.zip",
      "hash": "64c998d42e56f2b06c4dc69ec316fd4b217ff96daca0785ae9aaf33ee88fbf40"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
