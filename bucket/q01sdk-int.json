      "hash": "bd6c55feda4b4b1f81cf11488db2c5aa9a7dfd09f6515bdb445c768c58ce9f7a"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.1.0/q01sdk-windows-arm64.zip",
