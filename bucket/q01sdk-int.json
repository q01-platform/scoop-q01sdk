  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.11/q01sdk-windows-amd64.zip",
      "hash": "3159c895c8f0038820a9abffbc65f24d6b16d749f635fda023eafb7f82b7b545"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.11/q01sdk-windows-arm64.zip",
