  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.4/q01sdk-windows-amd64.zip",
      "hash": "8096ba8d4beb1934e2e74836d4f0c96168f483fa4a24879305dcfaabe376cfd4"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.4/q01sdk-windows-arm64.zip",
      "hash": "038d329cb42e7692cf694e4dd594035f0aeef5658cf82ab05a5cfce668ae1f8d"
    }
  },
  "bin": [
    [
      "q01sdk.exe",
      "q01sdk-int"
    ]
  ],
  "post_install": [
    "$configDir = \"$env:USERPROFILE\\.q01sdk\"",
    "New-Item -ItemType Directory -Path $configDir -Force | Out-Null",
    "$envFile = \"$configDir\\.env\"",
    "if (-not (Test-Path $envFile)) { Set-Content -Path $envFile -Value \"Host=https://app-int.q01.io`r`nEnv=int`r`nDEVTOOL=devspace\" }"
  ]
}
