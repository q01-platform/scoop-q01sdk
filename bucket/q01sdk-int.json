  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.2.0/q01sdk-windows-amd64.zip",
      "hash": "908beaf7c7c3afc53c7a24da9fcf9b5653d3deaa42291a1dd6b6168e63593619"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.2.0/q01sdk-windows-arm64.zip",
