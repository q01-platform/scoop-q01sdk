  "architecture": {
    "64bit": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.3/q01sdk-windows-amd64.zip",
      "hash": "8d753e5a2a244b39536951b1df747adef64d220db94a74feb76dabbaab3d3cf3"
    },
    "arm64": {
      "url": "https://sdk.q01.io/q01sdk/int/1.10.3/q01sdk-windows-arm64.zip",
